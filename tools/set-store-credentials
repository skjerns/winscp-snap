#!/usr/bin/env bash
#
# Export Snap Store credentials and put them in the STORE_LOGIN repository
# secret, checking on the way that what is being stored is actually usable.
#
# snapcraft expects SNAPCRAFT_STORE_CREDENTIALS to be the base64 blob that
# `export-login <file>` writes. Exporting to stdout instead prepends an
# "Exported login credentials:" line, which is not valid base64, and piping
# that straight into `gh secret set` stores a credential that fails only later,
# in CI, with "Credentials could not be parsed".
#
# Usage: tools/set-store-credentials
#
set -euo pipefail

ACLS="package_access,package_push,package_update,package_release"

D=$(mktemp -d)
trap 'chmod -R u+w "$D" 2>/dev/null || true; rm -rf "$D"' EXIT
F="$D/snap.login"

echo "Logging in to the Snap Store. Use the account that owns the winscp name."
snapcraft export-login --acls "$ACLS" "$F"

echo
echo "Checking the exported credentials.."
python3 - "$F" <<'PY'
import base64, binascii, json, sys

raw = open(sys.argv[1], "rb").read()
if not raw.strip():
    sys.exit("The exported file is empty.")

try:
    decoded = base64.b64decode(raw, validate=True).decode()
except (binascii.Error, UnicodeDecodeError) as err:
    head = raw[:60].decode("utf-8", "replace")
    sys.exit(
        f"Not base64: {err}\nThe file starts with: {head!r}\n"
        "If that looks like prose, the credentials were exported to stdout "
        "rather than to a file."
    )

try:
    creds = json.loads(decoded)
except json.JSONDecodeError:
    print("  decoded, but is not JSON; passing it on unchanged.")
else:
    print(f"  type: {creds.get('t', 'unknown')}")

print("  looks like a usable credential.")
PY

echo
gh secret set STORE_LOGIN < "$F"
echo "STORE_LOGIN set. Start a build with: gh workflow run main.yml --ref master"
